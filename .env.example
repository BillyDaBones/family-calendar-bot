ANTHROPIC_API_KEY=
# Optional; defaults to claude-opus-5-5
CLAUDE_MODEL=

# Optional; enables Jev triage of off-topic messages (DM questions, delete chatter)
TYPESAFE_API_KEY=
# Optional; defaults to jev-latest
TYPESAFE_MODEL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# On Railway: http://signal.railway.internal:8080
SIGNAL_API_URL=http://localhost:8080
SIGNAL_NUMBER=+15555550100
# From `bun run signal:groups`
SIGNAL_GROUP_ID=group.xxxx

# name, Signal number, invite email, and whether they want invite emails
MEMBERS_JSON=[{"name":"Billy","number":"+15555550100","email":"billy@gmail.com","invites":true}]

TIMEZONE=America/New_York
DATA_DIR=./data
